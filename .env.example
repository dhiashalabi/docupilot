# DocuPilot environment configuration.
# Copy to `.env` and adjust as needed: cp .env.example .env

# --- Postgres ---
POSTGRES_USER=docupilot
POSTGRES_PASSWORD=docupilot
POSTGRES_DB=docupilot

# --- Backend (consumed by FastAPI / Celery) ---
DATABASE_URL=postgresql+asyncpg://docupilot:docupilot@db:5432/docupilot
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
STORAGE_PATH=/data/storage
DEBUG=true
# Comma-separated list of browser origins allowed to call the API.
# Code defaults also include http://localhost:8080 when unset.
ALLOWED_ORIGINS=http://localhost:3000

# Max upload size (MB) and hard page-count limit for ingest.
MAX_UPLOAD_MB=50
MAX_DOCUMENT_PAGES=2000

# --- LLM (self-hosted OpenAI-compatible; vLLM in Compose) ---
VLLM_BASE_URL=http://vllm:8001/v1
VLLM_API_KEY=not-needed
# Default fits a single 24 GB GPU with the full 32k context.
LLM_MODEL=Qwen/Qwen3-14B-AWQ
LLM_CONTEXT_WINDOW=32768
#
# Pick the model by your GPU's VRAM (all served locally by vLLM):
#   ~16 GB GPU : LLM_MODEL=Qwen/Qwen3-8B-AWQ
#   24 GB GPU  : LLM_MODEL=Qwen/Qwen3-14B-AWQ   (default, recommended)
#   40 GB+ GPU : LLM_MODEL=Qwen/Qwen3-32B-AWQ
#
# Optional: required only if pulling gated models from Hugging Face.
HUGGING_FACE_HUB_TOKEN=

# --- Model weight downloads (offline-first) ---
# Faster downloads on the first pull (requires hf_transfer in the image).
HF_HUB_ENABLE_HF_TRANSFER=1
# After weights are cached once, set to 1 to forbid any network access at
# runtime (true offline operation).
# HF_HUB_OFFLINE=1

# --- Embeddings (BGE-M3) ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# FP16 only helps on a CUDA device; keep false on CPU.
EMBEDDING_USE_FP16=false
# Device for the in-process model: cpu, cuda, cuda:0, ... (blank = auto).
EMBEDDING_DEVICE=
# Optional: offload embeddings to a single self-hosted HTTP backend instead of
# loading the model in every process, e.g. http://worker:8002 (stays local).
EMBEDDING_BASE_URL=
# Load the in-process embedding model at startup so the first query isn't slow.
EMBEDDING_WARMUP=false

# --- RAG / retrieval ---
# Cross-encoder reranking is on by default; set false to save memory.
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# pgvector HNSW search breadth; higher = better recall, slower.
HNSW_EF_SEARCH=64

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
